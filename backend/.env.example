# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (leave blank until you have test keys — online payment hides itself)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173

# Store rules (whole rupees)
FREE_SHIPPING_ABOVE=1999
SHIPPING_FEE=99
COD_FEE=49
COD_MAX_ORDER=15000
PAYMENT_TIMEOUT_MINUTES=30
# Shop's PIN code (for delivery estimates) and days to pack before handing to courier
SHOP_PIN=522007
DISPATCH_DAYS=1

# Email (Resend) — blank = off
RESEND_API_KEY=
EMAIL_FROM=Lydia Purple Collections <orders@example.com>
SHOP_EMAIL=

# WhatsApp Cloud API — blank = off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER=
WHATSAPP_TEMPLATE_SHIPPED=
# Abandoned-cart reminder template (blank = automatic reminders off) and the shop's web address
WHATSAPP_TEMPLATE_CART=
SITE_URL=https://lydia-purple-collections.vercel.app
SHOP_WHATSAPP=919000000000
