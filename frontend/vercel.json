{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|meta-externalagent|instagram|telegrambot|twitterbot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview).*"
        }
      ],
      "destination": "/api/preview"
    },
    {
      "source": "/products/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|meta-externalagent|instagram|telegrambot|twitterbot|linkedinbot|slackbot|discordbot|pinterest|skypeuripreview).*"
        }
      ],
      "destination": "/api/preview?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}